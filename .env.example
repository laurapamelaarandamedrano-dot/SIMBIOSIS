# URL final del sitio publicado (sin barra final), por ejemplo:
# SITE_URL=https://tu-usuario.github.io
SITE_URL=https://example.github.io

# Ruta base del sitio. En GitHub Pages de proyecto suele ser "/nombre-del-repositorio".
# Dejar "/" si el sitio se publica en la raíz del dominio (Pages de usuario/organización o dominio propio).
SITE_BASE=/

# Modo vista previa: "true" agrega noindex/nofollow y bloquea el sitio en robots.txt.
# Cambiar a "false" únicamente cuando el sitio esté listo para publicarse de forma pública.
SITE_PREVIEW=true
