---
export type IconName =
  | 'search'
  | 'spark'
  | 'graduation'
  | 'union'
  | 'flag'
  | 'shield'
  | 'scale'
  | 'check-circle'
  | 'heart'
  | 'target'
  | 'compass'
  | 'book'
  | 'chat'
  | 'layers'
  | 'document'
  | 'clipboard'
  | 'lock';

interface Props {
  name: IconName;
}

const { name } = Astro.props;

const paths: Record<IconName, string> = {
  search: '<circle cx="10" cy="10" r="6"/><line x1="20" y1="20" x2="14.8" y2="14.8"/>',
  spark:
    '<line x1="12" y1="3" x2="12" y2="9"/><line x1="12" y1="15" x2="12" y2="21"/><line x1="3" y1="12" x2="9" y2="12"/><line x1="15" y1="12" x2="21" y2="12"/><line x1="5.6" y1="5.6" x2="9.5" y2="9.5"/><line x1="14.5" y1="14.5" x2="18.4" y2="18.4"/><line x1="18.4" y1="5.6" x2="14.5" y2="9.5"/><line x1="9.5" y1="14.5" x2="5.6" y2="18.4"/>',
  graduation:
    '<path d="M12 4 22 9l-10 5L2 9l10-5Z"/><path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/>',
  union: '<circle cx="9" cy="12" r="6"/><circle cx="15" cy="12" r="6"/>',
  flag: '<line x1="5" y1="3" x2="5" y2="21"/><path d="M5 4h13l-3 4 3 4H5Z"/>',
  shield: '<path d="M12 3 19 6v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3Z"/>',
  scale:
    '<line x1="12" y1="3" x2="12" y2="21"/><line x1="4" y1="7" x2="20" y2="7"/><path d="M4 7 2 12a3 3 0 0 0 4 0L4 7Z"/><path d="M20 7 18 12a3 3 0 0 0 4 0L20 7Z"/>',
  'check-circle': '<circle cx="12" cy="12" r="9"/><path d="M8 12.5 11 15.5 16 9"/>',
  heart:
    '<path d="M12 21C12 21 4 14 4 8.5 4 5.5 6.5 3 9.5 3 11 3 12 4 12 4S13 3 14.5 3C17.5 3 20 5.5 20 8.5 20 14 12 21 12 21Z"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5 13 13l-4.5 2.5L11 11l4.5-2.5Z"/>',
  book: '<path d="M3 6c3-1.5 6-1.5 9 0v13c-3-1.5-6-1.5-9 0V6Z"/><path d="M21 6c-3-1.5-6-1.5-9 0v13c3-1.5 6-1.5 9 0V6Z"/>',
  chat: '<path d="M4 5h16v11H9l-5 4V5Z"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="8" y1="12.5" x2="13" y2="12.5"/>',
  layers: '<path d="M12 3 21 8l-9 5-9-5 9-5Z"/><path d="M3 12l9 5 9-5"/><path d="M3 16l9 5 9-5"/>',
  document:
    '<path d="M6 3h9l5 5v13H6V3Z"/><path d="M15 3v5h5"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="15" y2="16"/>',
  clipboard:
    '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="13" y2="18"/>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
};
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
