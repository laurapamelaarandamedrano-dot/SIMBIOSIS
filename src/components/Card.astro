---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  titulo: string;
  texto: string;
  indice?: string;
  icon?: IconName;
  badge?: string;
  id?: string;
  color?: 'rosa' | 'turquesa' | 'ambar' | 'civica';
  as?: 'h2' | 'h3' | 'h4';
}

const { titulo, texto, indice, icon, badge, id, color = 'civica', as: Tag = 'h3' } = Astro.props;
---

<div class:list={['card', 'tilt', 'reveal', `card--${color}`]}>
  <div class="card__top">
    {icon && (
      <span class="card__badge" aria-hidden="true">
        <Icon name={icon} />
      </span>
    )}
    {indice && <p class="card__index" aria-hidden="true">{indice}</p>}
  </div>
  <Tag id={id}>
    {titulo}
    {badge && <span class="tag-propuesta">{badge}</span>}
  </Tag>
  <p>{texto}</p>
</div>
