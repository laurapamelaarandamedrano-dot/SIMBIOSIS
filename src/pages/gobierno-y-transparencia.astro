---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import GovChart from '../components/GovChart.astro';
import {
  naturalezaJuridica,
  objetoInstitucional,
  finalidadesActividades,
  membresiaFormal,
  independenciaInstitucional,
  conflictosInteres,
  eticaIntegridad,
  propiedadIntelectual,
  proteccionDatos,
  financiamientoTransparencia,
  rendicionCuentas,
} from '../data/content';
---

<BaseLayout
  title="Gobierno y transparencia"
  description="Naturaleza jurídica proyectada, órganos de gobierno, independencia, ética, protección de datos, financiamiento y rendición de cuentas de SIMBIOSIS."
>
  <PageHeader
    eyebrow="Gobierno y transparencia"
    titulo="Cómo se gobierna SIMBIOSIS"
    descripcion="La arquitectura institucional que SIMBIOSIS proyecta para constituirse como una organización independiente, con reglas claras de gobierno, ética y rendición de cuentas."
  />

  <section class="section" aria-labelledby="naturaleza-titulo">
    <div class="container">
      <p class="eyebrow">Naturaleza jurídica proyectada</p>
      <h2 id="naturaleza-titulo">Una asociación civil sin fines de lucro</h2>
      <p class="lede">{naturalezaJuridica}</p>
      <h3>Objeto institucional</h3>
      <p>{objetoInstitucional}</p>
      <h3>Finalidades y actividades</h3>
      <ul class="chip-list">
        {finalidadesActividades.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="membresia-formal-titulo">
    <div class="container">
      <p class="eyebrow">Membresía formal</p>
      <h2 id="membresia-formal-titulo">Tres formas de pertenecer</h2>
      <div class="grid grid--3 reveal-stagger">
        {membresiaFormal.map((m) => (
          <div class="linea-card-light reveal">
            <h3>{m.titulo}</h3>
            <p>{m.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="organos-titulo">
    <div class="container">
      <p class="eyebrow">Órganos de gobierno</p>
      <h2 id="organos-titulo" class="reveal">Estructura de gobierno proyectada</h2>
      <GovChart />
    </div>
  </section>

  <section class="section" aria-labelledby="independencia-titulo">
    <div class="container">
      <div class="grid grid--2">
        <div class="participa-block reveal">
          <h2 id="independencia-titulo">Independencia institucional</h2>
          <p>{independenciaInstitucional}</p>
        </div>
        <div class="participa-block reveal">
          <h2>Conflictos de interés</h2>
          <p>{conflictosInteres}</p>
        </div>
        <div class="participa-block reveal">
          <h2>Ética e integridad</h2>
          <p>{eticaIntegridad}</p>
        </div>
        <div class="participa-block reveal">
          <h2>Propiedad intelectual</h2>
          <p>{propiedadIntelectual}</p>
        </div>
        <div class="participa-block reveal">
          <h2>Protección de datos</h2>
          <p>{proteccionDatos}</p>
        </div>
        <div class="participa-block reveal">
          <h2>Financiamiento y transparencia</h2>
          <p>{financiamientoTransparencia}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="rendicion-titulo">
    <div class="container">
      <p class="eyebrow">Rendición de cuentas</p>
      <h2 id="rendicion-titulo">Cómo se supervisa el uso de los recursos</h2>
      <p class="lede">{rendicionCuentas}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .chip-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding: 0;
    margin: var(--space-sm) 0 0;
  }

  .chip-list li {
    background: rgba(28, 100, 168, 0.08);
    border: 1px solid var(--color-border);
    color: var(--color-blue-deep);
    padding: var(--space-2xs) var(--space-sm);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .linea-card-light {
    background: var(--surface-card);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-blue-civic);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .linea-card-light p:last-child {
    margin: 0;
  }

  .participa-block {
    background: var(--surface-card);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-turquoise);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .participa-block h2 {
    font-size: 1.2rem;
  }

  .participa-block p {
    margin: 0;
  }
</style>
