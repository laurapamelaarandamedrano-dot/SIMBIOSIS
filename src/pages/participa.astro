---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { membresia, org } from '../data/content';
---

<BaseLayout
  title="Participa"
  description="Quién puede participar en SIMBIOSIS, qué significa pertenecer y cómo se prevé contribuir a su agenda."
>
  <PageHeader
    eyebrow="Participa"
    titulo="Súmate a SIMBIOSIS"
    descripcion="La membresía es uno de los pilares de la organización: personas y organizaciones que comparten sus valores y contribuyen activamente a su agenda."
  />

  <section class="section" aria-labelledby="quien-titulo">
    <div class="container">
      <div class="grid grid--2">
        <div class="participa-block reveal">
          <h2 id="quien-titulo">Quién puede participar</h2>
          <p>{membresia.quien}</p>
        </div>
        <div class="participa-block reveal">
          <h2>Qué significa pertenecer</h2>
          <p>{membresia.pertenecer}</p>
        </div>
        <div class="participa-block reveal">
          <h2>Cómo contribuir</h2>
          <p>{membresia.contribuir}</p>
        </div>
        <div class="participa-block reveal">
          <h2>Beneficios institucionales <span class="tag-propuesta">Propuesta</span></h2>
          <p>{membresia.beneficios}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--band text-center" aria-labelledby="aviso-titulo">
    <div class="container">
      <h2 id="aviso-titulo">Aún no está abierta la membresía</h2>
      <p class="lede lede--centered">
        {org.estatus} La membresía formal se abrirá una vez que {org.nombreCorto} concluya su
        proceso de constitución. Esta página se actualizará con el mecanismo de inscripción en
        ese momento.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .participa-block {
    background: var(--surface-card);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-turquoise);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .participa-block p {
    margin: 0;
  }

  .tag-propuesta {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-blue-deep-dark);
    background: var(--color-amber);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    vertical-align: middle;
    margin-left: var(--space-2xs);
  }
</style>
