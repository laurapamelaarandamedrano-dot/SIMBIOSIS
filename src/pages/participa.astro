---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Card from '../components/Card.astro';
import { membresia, org } from '../data/content';

const bloques = [
  { titulo: 'Quién puede participar', texto: membresia.quien, icon: 'union', color: 'turquesa', badge: undefined },
  { titulo: 'Qué significa pertenecer', texto: membresia.pertenecer, icon: 'heart', color: 'rosa', badge: undefined },
  { titulo: 'Cómo contribuir', texto: membresia.contribuir, icon: 'spark', color: 'ambar', badge: undefined },
  {
    titulo: 'Beneficios institucionales',
    texto: membresia.beneficios,
    icon: 'shield',
    color: 'civica',
    badge: 'Propuesta',
  },
] as const;
---

<BaseLayout
  title="Participa"
  description="Quién puede participar en SIMBIOSIS, qué significa pertenecer y cómo se prevé contribuir a su agenda."
>
  <PageHeader
    eyebrow="Participa"
    titulo="Súmate a SIMBIOSIS"
    descripcion="La membresía es uno de los pilares de la organización: personas y organizaciones que comparten sus valores y contribuyen activamente a su agenda."
  />

  <section class="section" aria-labelledby="quien-titulo">
    <div class="container">
      <div class="grid grid--2">
        {bloques.map((b, i) => (
          <Card
            as="h2"
            id={i === 0 ? 'quien-titulo' : undefined}
            titulo={b.titulo}
            texto={b.texto}
            icon={b.icon}
            color={b.color}
            badge={b.badge}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--band text-center" aria-labelledby="aviso-titulo">
    <div class="container">
      <h2 id="aviso-titulo">Aún no está abierta la membresía</h2>
      <p class="lede lede--centered">
        {org.estatus} La membresía formal se abrirá una vez que {org.nombreCorto} concluya su
        proceso de constitución. Esta página se actualizará con el mecanismo de inscripción en
        ese momento.
      </p>
    </div>
  </section>
</BaseLayout>
