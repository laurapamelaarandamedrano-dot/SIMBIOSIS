---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Card from '../components/Card.astro';
import { valores, principiosActuacion, politicasGenerales } from '../data/content';

const cardColors = ['rosa', 'turquesa', 'ambar', 'civica'] as const;
---

<BaseLayout
  title="Principios y valores"
  description="Los valores, principios de actuación y políticas generales que guían el trabajo de SIMBIOSIS."
>
  <PageHeader
    eyebrow="Principios y valores"
    titulo="Cómo actuamos"
    descripcion="Los valores y principios que sostienen cada proyecto, y las políticas generales que enmarcan nuestra actuación pública."
  />

  <section class="section" aria-labelledby="valores-titulo">
    <div class="container">
      <p class="eyebrow">Valores</p>
      <h2 id="valores-titulo">Lo que nos define</h2>
      <div class="grid grid--3 reveal-stagger">
        {valores.map((v, i) => (
          <Card titulo={v.titulo} texto={v.texto} icon={v.icon} color={cardColors[i % cardColors.length]} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="principios-titulo">
    <div class="container">
      <p class="eyebrow">Principios de actuación</p>
      <h2 id="principios-titulo" class="reveal">Cómo trabajamos</h2>
      <dl class="principios-list reveal-stagger">
        {principiosActuacion.map((p) => (
          <div class="principios-list__row reveal">
            <dt>{p.titulo}</dt>
            <dd>{p.texto}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="politicas-titulo">
    <div class="container">
      <p class="eyebrow">Políticas generales</p>
      <h2 id="politicas-titulo">Alianzas, incidencia y transparencia</h2>
      <div class="grid grid--3 reveal-stagger">
        {politicasGenerales.map((p, i) => (
          <Card titulo={p.titulo} texto={p.texto} icon={p.icon} color={cardColors[(i + 1) % cardColors.length]} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .principios-list {
    margin: var(--space-lg) 0 0;
    display: grid;
    gap: var(--space-md);
  }

  .principios-list__row {
    border-left: 3px solid var(--color-amber);
    padding-left: var(--space-md);
  }

  .principios-list__row dt {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-white);
    font-size: 1.1rem;
  }

  .principios-list__row dd {
    margin: var(--space-2xs) 0 0;
    color: rgba(255, 255, 255, 0.88);
  }

</style>
