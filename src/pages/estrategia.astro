---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { etapas, relacionesInstitucionales, publicaciones, difusion } from '../data/content';
---

<BaseLayout
  title="Estrategia"
  description="Las tres etapas de crecimiento de SIMBIOSIS, sus relaciones institucionales y su estrategia de publicaciones y difusión."
>
  <PageHeader
    eyebrow="Estrategia"
    titulo="De la consolidación a la proyección internacional"
    descripcion="Una ruta en tres etapas para construir una organización sólida, con relaciones institucionales amplias y una agenda pública de publicaciones y difusión."
  />

  <section class="section" aria-labelledby="etapas-titulo">
    <div class="container">
      <p class="eyebrow">Etapas <span class="tag-propuesta">Propuesta</span></p>
      <h2 id="etapas-titulo">Tres etapas de crecimiento</h2>
      <ol class="stage-list reveal-stagger">
        {etapas.map((e) => (
          <li class="stage-list__item reveal">
            <span class="stage-list__number" aria-hidden="true">{e.numero}</span>
            <h3>{e.titulo}</h3>
            <p>{e.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="relaciones-titulo">
    <div class="container">
      <p class="eyebrow">Relaciones institucionales</p>
      <h2 id="relaciones-titulo" class="reveal">Con quién nos vinculamos</h2>
      <p class="lede reveal">{relacionesInstitucionales}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="publicaciones-titulo">
    <div class="container">
      <p class="eyebrow">Publicaciones y difusión <span class="tag-propuesta">Propuesta</span></p>
      <h2 id="publicaciones-titulo">Tres series propias</h2>
      <div class="grid grid--3 reveal-stagger">
        {publicaciones.map((p, i) => (
          <div class:list={['card', 'tilt', 'reveal', `card--${['rosa', 'turquesa', 'ambar'][i % 3]}`]}>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </div>
        ))}
      </div>
      <p class="lede reveal difusion-text">{difusion}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .tag-propuesta {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-blue-deep-dark);
    background: var(--color-amber);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    vertical-align: middle;
    margin-left: var(--space-2xs);
  }

  .stage-list {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-md);
    counter-reset: stage;
  }

  .stage-list__item {
    position: relative;
    background: var(--surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg) var(--space-md) var(--space-md);
  }

  .stage-list__number {
    position: absolute;
    top: -1rem;
    left: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background: var(--gradient-institucional);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.2rem;
  }

  .stage-list__item h3 {
    margin-top: var(--space-sm);
  }

  .stage-list__item p:last-child {
    margin: 0;
  }

  .difusion-text {
    margin-top: var(--space-lg);
  }
</style>
